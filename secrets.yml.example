# 로컬 개발용 시크릿 템플릿.
#
#   cp secrets.yml.example secrets.yml
#
# 후 실제 값을 채운다. 값은 반드시 복사본인 secrets.yml 에만 적는다 —
# 이 파일(secrets.yml.example)은 git 추적 대상이라 여기 적은 값은 커밋에 딸려 올라간다.
# secrets.yml 은 .gitignore 대상이라 커밋되지 않는다.
# 운영은 이 파일이 아니라 환경변수·시크릿 매니저로 주입한다 — KIS 워커 명세 §5.
#
# 각 서버의 application-local.yml(local 프로파일)이 spring.config.import로 저장소
# 루트의 secrets.yml을 optional 로 읽는다. 파일이 없으면 조용히 무시되고 환경변수
# 경로로 동작한다. local 프로파일을 켜지 않으면(테스트·운영) 이 파일은 읽히지 않는다.
#
# import된 파일이 import한 문서보다 우선하므로, 여기 적은 값은 application-local.yml의
# 같은 키도 덮어쓴다.

alphatalk:
  # ── worker-price · worker-batch — 한국투자증권 KIS OpenAPI ──────────────────
  # 발급: KIS Developers 포털에서 계좌 연결 후 앱키 신청.
  # 실전 계좌 앱키만 쓴다 — 워커는 실전 도메인만 호출한다(KIS 워커 명세 §1.1).
  # accounts-json이 곧 스위치다 — 비워 두면 KIS 수집 평면 전체가 비활성(KIS 워커 명세 v0.9).
  price:
    accounts-json: '[{"keyId":"real-1","appkey":"발급받은appkey","appsecret":"발급받은appsecret"}]'

  # ── worker-batch — OpenDART (기업개황·재무·공시) ───────────────────────────
  # 발급: https://opendart.fss.or.kr 가입 → 인증키 신청. 무료, 하루 20,000건.
  batch:
    dart:
      api-key: ""
    # 투자의견 수집(invest_opinion_sync)·밸류에이션 수집(valuation_daily) — price와 같은 KIS 계정을 쓴다(토큰은 Redis 공유).
    # valuation_daily는 기본 활성이라 이 계정이 비면 worker-batch가 기동에 실패한다.
    kis:
      accounts-json: '[{"keyId":"real-1","appkey":"발급받은appkey","appsecret":"발급받은appsecret"}]'
    opinion:
      enabled: true
      # 로컬은 기본이 수동 트리거다(application-local.yml이 cron을 꺼 둔다) — 실계정 KIS 호출과
      # DB·Redis 쓰기가 bootRun만으로 시작되지 않게 하기 위함. 자동 실행이 필요하면 아래 주석을 푼다.
      # cron: "0 0/10 7-17 * * MON-FRI"        # 영업일 07:00~17:50 · 10분 주기 (약 4k콜/일)
    valuation:
      # PER·PBR·EPS·BPS + 시총 일일 적재. 로컬도 기본은 수동 트리거다 — 자동 실행이 필요하면 아래를 푼다.
      # cron: "0 50 16 * * MON-FRI"            # 영업일 16:50 · 전 종목 ~2,600콜
      # retry-cron: "0 20 17,18 * * MON-FRI"   # 부분 실패 회차 재실행

  # ── worker-llm — Anthropic API 직접 호출용 ────────────────────────────────
  # local 프로파일 기본 provider는 로그인된 gemini-cli 구독이라 보통 비워 둔다.
  # API 키로 붙일 때만 채우고 provider를 anthropic 으로 바꾼다.
  llm:
    anthropic:
      api-key: ""
