# 로컬 개발용 시크릿 템플릿.
#
#   cp secrets.yml.example secrets.yml
#
# 후 실제 값을 채운다. 값은 반드시 복사본인 secrets.yml 에만 적는다 —
# 이 파일(secrets.yml.example)은 git 추적 대상이라 여기 적은 값은 커밋에 딸려 올라간다.
# secrets.yml 은 .gitignore 대상이라 커밋되지 않는다.
# 운영은 이 파일이 아니라 환경변수·시크릿 매니저로 주입한다 — KIS 워커 명세 §5.
#
# 각 서버의 application-local.yml(local 프로파일)이 spring.config.import로 저장소
# 루트의 secrets.yml을 optional 로 읽는다. 파일이 없으면 조용히 무시되고 환경변수
# 경로로 동작한다. local 프로파일을 켜지 않으면(테스트·운영) 이 파일은 읽히지 않는다.
#
# import된 파일이 import한 문서보다 우선하므로, 여기 적은 값은 application-local.yml의
# 같은 키도 덮어쓴다.

alphatalk:
  # ── worker-price · worker-batch — 한국투자증권 KIS OpenAPI ──────────────────
  # 발급: KIS Developers 포털에서 계좌 연결 후 앱키 신청.
  # 실전 계좌 키는 env: prod, 모의투자 키는 env: vts 다 — 키와 env가 어긋나면 인증이 깨진다.
  price:
    enabled: true
    env: prod
    accounts-json: '[{"keyId":"real-1","appkey":"발급받은appkey","appsecret":"발급받은appsecret"}]'

  # ── worker-ingest — 네이버 검색 API ────────────────────────────────────────
  # 발급: 네이버 개발자센터에서 애플리케이션 등록 → 사용 API로 "검색" 선택.
  # 비워 두면 네이버 소스만 비활성되고 RSS 수집은 그대로 동작한다.
  ingest:
    naver:
      client-id: ""
      client-secret: ""

  # ── worker-llm — Anthropic API 직접 호출용 ────────────────────────────────
  # local 프로파일 기본 provider는 claude-cli(구독)라 보통 비워 둔다.
  # API 키로 붙일 때만 채우고 provider를 anthropic 으로 바꾼다.
  llm:
    anthropic:
      api-key: ""
